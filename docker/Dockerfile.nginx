FROM node:24-alpine AS builder
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN chmod +x node_modules/.bin/* && npx tsc -b && npx vite build

FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
COPY model /usr/share/models
RUN find /usr/share/nginx/html /usr/share/models -type f \( \
      -name "*.js" -o -name "*.css" -o -name "*.json" -o -name "*.svg" -o \
      -name "*.html" -o -name "*.wasm" \
    \) -exec gzip -kf -9 {} \; && \
    chmod -R a+rX /usr/share/nginx/html /usr/share/models
